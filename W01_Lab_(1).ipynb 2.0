      "source": [
        "### D1. Say hello\n",
        "\n",
        "Print three lines:\n",
        "\n",
        "```\n",
        "==============================\n",
        "CST1510 - your name\n",
        "==============================\n",
        "```\n",
        "\n",
        "Use `\"=\" * 30` for the lines, not thirty typed characters."
      ],
      "id": "RQS88Bbs3pW7"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
